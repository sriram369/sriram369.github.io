# --- Vercel project (holds the /api/chat function only) ---
# Set these in the Vercel dashboard as env vars — never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- GH Pages build (this repo) ---
# Public, non-secret — just tells the frontend where the Vercel proxy lives.
# Copy to .env.local (or set before running `npm run build`).
VITE_CHAT_API_URL=https://sriram369-github-io.vercel.app/api/chat
